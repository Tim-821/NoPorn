<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 头部 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/gold" />

        <!-- 密钥卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:text="检查中…" />

            <TextView
                android:id="@+id/fingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="@color/text_sub"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/pubkeyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:textColor="#B0BEC5"
                android:fontFamily="monospace"
                android:background="@drawable/bg_input"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnCopyPub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:textColor="@color/text_main"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="复制公钥（发给 Mac）" />

            <Button
                android:id="@+id/btnGen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:textColor="@color/text_sub"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="生成新密钥（旧密钥作废）" />
        </LinearLayout>

        <!-- 签名卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:text="安装请求" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_sub"
                android:text="从邮件点进来会自动填入请求码，核对无误后点同意" />

            <EditText
                android:id="@+id/challenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minLines="3"
                android:gravity="top"
                android:hint="FLIGHT1|1234|nonce|hash16"
                android:inputType="textMultiLine"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_main"
                android:textColorHint="#5A6B87"
                android:background="@drawable/bg_input"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@null"
                android:textColor="#0B1220"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="同意并签名" />

            <TextView
                android:id="@+id/recipientView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <Button
                android:id="@+id/btnRecipient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:textColor="@color/text_sub"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="设置回传邮箱" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
